{
  "name": "printflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "copy-lint": "node scripts/copy-lint/copy-linter.js",
    "check:migrations": "node scripts/check-migrations-security.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "security-grep": "node scripts/security-grep-gate.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "ui-audit": "node --experimental-strip-types scripts/ui-audit/check.ts",
    "brand-check": "node scripts/brand-check.mjs",
    "test": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --conditions=react-server --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.ts tests/security/*.test.ts tests/roles/*.test.ts tests/edge-cases/*.test.ts tests/acceptance/*.test.ts"
  },
  "dependencies": {
    "@formepdf/core": "^0.31.0",
    "@formepdf/react": "^0.31.0",
    "@hookform/resolvers": "^7.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2"
  }
}
