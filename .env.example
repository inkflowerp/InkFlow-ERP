# ==============================================================================
# PrintERP SaaS - Environment Configuration Template
# Copy this file to .env.local for local development.
# Configure corresponding variables in Vercel Project Settings for Production/Preview.
#
# IMPORTANT SECURITY RULE:
# - NEXT_PUBLIC_* variables ARE exposed to the client-side JavaScript bundle.
# - ALL OTHER variables ARE STRICTLY SERVER-SIDE SECRETS. NEVER prefix secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION (Client-Side Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PrintERP SaaS"
NEXT_PUBLIC_DEFAULT_LOCALE=bn # 'bn' (Bangla) | 'en' (English) | 'bi' (Bilingual)
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Public Supabase API credentials (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# CRITICAL SERVER-SIDE SECRET: Supabase Service Role Key
# Grants administrative database bypass for tenant provisioning, system audits, and background tasks.
# NEVER EXPOSE THIS KEY TO THE BROWSER.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database direct connection string for migrations (port 5432 or connection pooler port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. SECURE STORAGE & FILE SIGNING (Server-Side Secrets)
# ------------------------------------------------------------------------------
STORAGE_SIGNING_SALT=generate-a-strong-random-64-character-hex-salt-here
STORAGE_DEFAULT_EXPIRY_SECONDS=900
STORAGE_BUCKET_CUSTOMER_ARTWORKS=customer-artworks
STORAGE_BUCKET_PREPRESS_PROOFS=prepress-proofs
STORAGE_BUCKET_INVOICES=invoices
STORAGE_BUCKET_RECEIPTS=payment-receipts

# ------------------------------------------------------------------------------
# 4. BANGLADESHI PAYMENT GATEWAYS (Server-Side Secrets)
# ------------------------------------------------------------------------------
# bKash Merchant Tokenized Checkout API
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-merchant-username
BKASH_PASSWORD=your-bkash-merchant-password
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta # Use sandbox or live endpoint

# Nagad Merchant Payment Gateway
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_PUBLIC_KEY=your-nagad-pg-public-key
NAGAD_PRIVATE_KEY=your-nagad-merchant-private-key

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# 5. BANGLADESHI SMS & MESSAGING GATEWAYS (Server-Side Secrets)
# ------------------------------------------------------------------------------
# BulkSMSBD Gateway (Bangladeshi Masking & Non-Masking SMS)
BULKSMSBD_API_KEY=your-bulksmsbd-api-key
BULKSMSBD_SENDER_ID=your-approved-sender-id # e.g. 8809612... or Brand Masking

# SSL Wireless SMS Gateway
SSL_WIRELESS_API_TOKEN=your-ssl-wireless-api-token
SSL_WIRELESS_SID=your-stakeholder-id

# Meta WhatsApp Cloud API (Business Platform)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & PRODUCTION SAFEGUARDS
# ------------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=120
CRON_SECRET=generate-a-strong-random-hex-string-for-cron-job-authorization
ENCRYPTION_SECRET=generate-a-32-byte-hex-secret-for-aes-256-gcm-credential-encryption

# ------------------------------------------------------------------------------
# 7. EMAIL INFRASTRUCTURE (GMAIL OAUTH 2.0 & SMTP)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials (for Gmail API integration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/email/oauth/google/callback

# Default Platform SMTP Infrastructure (Optional / Fallback)
PLATFORM_SMTP_HOST=smtp.printerp.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=notifications@printerp.com
PLATFORM_SMTP_PASSWORD=your-platform-smtp-password

