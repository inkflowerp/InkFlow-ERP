# ==============================================================================
# PrintERP SaaS - Environment Configuration Template
# Copy this file to .env.local for local development.
# Configure corresponding variables in Vercel Project Settings for Production/Preview.
#
# IMPORTANT SECURITY RULE:
# - NEXT_PUBLIC_* variables ARE exposed to the client-side JavaScript bundle.
# - ALL OTHER variables ARE STRICTLY SERVER-SIDE SECRETS. NEVER prefix secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION (Client-Side Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PrintERP SaaS"
NEXT_PUBLIC_DEFAULT_LOCALE=bn # 'bn' (Bangla) | 'en' (English) | 'bi' (Bilingual)
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000 # e.g. printerp.com.bd or inkflowerp.com in production

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Public Supabase API credentials (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# CRITICAL SERVER-SIDE SECRET: Supabase Service Role Key
# Grants administrative database bypass for tenant provisioning, system audits, and background tasks.
# NEVER EXPOSE THIS KEY TO THE BROWSER.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database connection pooler URL (port 6543 with transaction pooling for runtime queries)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Database direct connection URL (port 5432 for Prisma DDL migrations & session pooling)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. SECURE STORAGE & ENCRYPTION SECRETS (Server-Side Secrets)
# ------------------------------------------------------------------------------
ENCRYPTION_SECRET=generate-a-32-byte-hex-secret-for-aes-256-gcm-credential-encryption
STORAGE_SIGNING_SALT=generate-a-strong-random-64-character-hex-salt-here

# ------------------------------------------------------------------------------
# 4. BANGLADESHI PAYMENT GATEWAYS (Server-Side Fallbacks / Defaults)
# NOTE: In multi-tenant production, tenants configure encrypted credentials
# dynamically via PostgreSQL 'gateway_integrations'. Environment variables below
# serve as platform-level fallbacks/defaults.
# ------------------------------------------------------------------------------
# bKash Merchant Tokenized Checkout API
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-merchant-username
BKASH_PASSWORD=your-bkash-merchant-password
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta # Use sandbox or live endpoint

# Nagad Merchant Payment Gateway
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_PUBLIC_KEY=your-nagad-pg-public-key
NAGAD_MERCHANT_PRIVATE_KEY=your-nagad-merchant-private-key
NAGAD_PRIVATE_KEY=your-nagad-merchant-private-key # Alias supported for compatibility

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_SANDBOX=false

# ------------------------------------------------------------------------------
# 5. BANGLADESHI SMS & MESSAGING GATEWAYS (Server-Side Fallbacks / Defaults)
# NOTE: Tenants configure encrypted credentials via PostgreSQL 'gateway_integrations'.
# Environment variables below serve as platform-level fallbacks/defaults.
# ------------------------------------------------------------------------------
# Greenweb / Bangladeshi SMS Gateways
GREENWEB_SMS_TOKEN=your-greenweb-sms-token
SMS_API_KEY=your-sms-api-key # Optional fallback
BULKSMSBD_API_KEY=your-bulksmsbd-api-key # Optional BulkSMSBD provider key

# Meta WhatsApp Cloud API (Business Platform)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verification-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token # Alias supported for compatibility

# ------------------------------------------------------------------------------
# 6. PRODUCTION SAFEGUARDS, PERSISTENCE & CRON
# ------------------------------------------------------------------------------
# Set to 'production' to strictly enforce Supabase PostgreSQL and forbid RAM store fallback
FINANCIAL_PERSISTENCE_MODE=production
CRON_SECRET=generate-a-strong-random-hex-string-for-cron-job-authorization

# Development / Testing MFA TOTP bypass secret (Ignored in production)
PLATFORM_MFA_DEFAULT_SECRET=JBSWY3DPEHPK3PXP

# ------------------------------------------------------------------------------
# 7. EMAIL INFRASTRUCTURE (GMAIL OAUTH 2.0, RESEND & SMTP)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials (for Gmail API integration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/email/oauth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback # Auth callback alias

# Resend API Key (Optional platform transactional email provider)
RESEND_API_KEY=re_your_resend_api_key_here

# Default Platform SMTP Infrastructure (Optional / Fallback)
PLATFORM_SMTP_HOST=smtp.printerp.com
SMTP_HOST=smtp.printerp.com # Alias supported
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=notifications@printerp.com
PLATFORM_SMTP_PASSWORD=your-platform-smtp-password

# ------------------------------------------------------------------------------
# 8. OPENWA MULTI-TENANT WHATSAPP GATEWAY (DOCKER / PERSISTENT VPS)
# ------------------------------------------------------------------------------
# OpenWA Gateway API Base URL (must point to /api on the OpenWA server)
OPENWA_BASE_URL=http://localhost:2785/api
# OpenWA Master/Admin API Key (passed in X-API-Key header)
OPENWA_API_KEY=owa_k1_your_openwa_admin_key_here
# OpenWA Webhook Secret for HMAC-SHA256 signature verification (X-OpenWA-Signature)
OPENWA_WEBHOOK_SECRET=your_minimum_16_char_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 9. INBOUND WEBHOOK SECRETS & SIGNATURE VERIFICATION
# (Required in production for webhook authenticity validation)
# ------------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
TELEGRAM_BOT_WEBHOOK_SECRET=your_telegram_bot_webhook_secret_token_here
